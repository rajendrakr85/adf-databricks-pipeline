					},
					{
						"name": "patient_count",
						"type": "String"
					},
					{
						"name": "male_participants",
						"type": "String"
					},
					{
						"name": "female_participants",
						"type": "String"
					},
					{
						"name": "age_range",
						"type": "String"
					},
					{
						"name": "efficacy_rate",
						"type": "String"
					},
					{
						"name": "placebo_efficacy",
						"type": "String"
					},
					{
						"name": "adverse_events_count",
						"type": "String"
					},
					{
						"name": "serious_adverse_events",
						"type": "String"
					},
					{
						"name": "trial_status",
						"type": "String"
					},
					{
						"name": "sponsor",
						"type": "String"
					},
					{
						"name": "budget_millions",
						"type": "String"
					},
					{
						"name": "completion_rate",
						"type": "String"
					},
					{
						"name": "data_quality_score",
						"type": "String"
					},
					{
						"name": "publication_status",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/copyset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage2",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"allfiles": {
						"type": "string"
					}
				},
				"annotations": [],
