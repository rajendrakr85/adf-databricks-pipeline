						},
						"fileSystem": "staging"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "trial_id",
						"type": "String"
					},
					{
						"name": "drug_name",
						"type": "String"
					},
					{
